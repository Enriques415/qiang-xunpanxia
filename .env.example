# 复制为 .env.local。不要把真实密钥提交进仓库。

# Docker Compose 把 Postgres 映射到 54329。若本机已有 Postgres，改成实际端口。
DATABASE_URL=postgres://xunpan:xunpan@127.0.0.1:54329/xunpanxia

# 后台和邮件链接用的对外地址。本地开发保持下面这个端口。
APP_URL=http://127.0.0.1:47281

# 至少 16 位。用来给会话令牌加盐，并在没单独设置时加密 Webhook。
AUTH_SECRET=replace-with-32-plus-random-characters
WEBHOOK_SECRET=replace-with-another-random-secret

# console：把信记在终端和 /dev/mailbox，不外发。
# resend：走 Resend。换成阿里云邮件推送或 SendCloud 时，新增一个 MailProvider，不要改询盘业务代码。
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM="询盘匣 <inquiries@yourdomain.com>"

# 保护 POST /api/internal/notifications/drain ，给外部定时任务重试通知。
CRON_SECRET=replace-with-random

# 同一 IP + 同一访问密钥，每分钟允许的提交次数。
RATE_LIMIT_PER_MINUTE=20

# 在反向代理后面时读取 X-Forwarded-For。本地直连可设为 false。
TRUST_PROXY=true
